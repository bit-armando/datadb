{
  "name": "datadb",
  "version": "0.1.0",
  "description": "Cliente de bases de datos de escritorio para macOS (PostgreSQL, MySQL, SQL Server, MongoDB).",
  "license": "MIT",
  "author": "Armando Rosales",
  "homepage": "https://github.com/bit-armando/datadb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bit-armando/datadb.git"
  },
  "bugs": {
    "url": "https://github.com/bit-armando/datadb/issues"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:desktop": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "tsx --test \"src/**/*.test.ts\" \"electron/**/*.test.ts\"",
    "gen:tokens": "tsx scripts/gen-tokens.ts",
    "icons:import": "tsx scripts/import-intellij-icons.ts",
    "icons:sheet": "tsx scripts/contact-sheet.ts",
    "dist": "npm run build && electron-builder --mac dmg --arm64",
    "dist:dir": "npm run build && electron-builder --mac dir --arm64",
    "instalar": "bash scripts/instalar.sh"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.1171.0",
    "@aws-sdk/rds-signer": "^3.1171.0",
    "@base-ui/react": "^1.7.0",
    "@glideapps/glide-data-grid": "6.0.4-alpha24",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.11.0",
    "html-to-image": "^1.11.13",
    "lodash": "4.18.1",
    "lucide-react": "^1.31.0",
    "marked": "16.4.2",
    "mongodb": "^7.7.0",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "react-responsive-carousel": "3.2.23",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "sql-formatter": "^15.8.2",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/dagre": "^0.7.54",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7"
  },
  "main": "out/main/main.js"
}
